{
  // The game runs Lua 5.1. The WoW API extension (ketho.wow-api) adds the
  // game's globals when it sees the .toc; these are the addon's own.
  "Lua.runtime.version": "Lua 5.1",
  "Lua.diagnostics.globals": [
    "VanguardDB",
    "VanguardCharDB",
    "Vanguard",
    "SLASH_VANGUARD1",
    "SLASH_VANGUARD2",
    "GetMinimapShape",
    "Vanguard_OnAddonCompartmentClick"
  ],
  "Lua.workspace.ignoreDir": ["node_modules", "dist", "preview", ".git"],
  "Lua.workspace.checkThirdParty": false,
  "[lua]": { "editor.tabSize": 2, "editor.insertSpaces": true },
  "files.eol": "\n",
  "search.exclude": { "dist": true, "preview": true, "Media/Fonts": true }
}
