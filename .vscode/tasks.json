{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "verify",
      "detail": "Every Vitest suite (Lua under the TEST-ONLY WoW stub, media, link:wow, coverage tool), then the code-quality scan",
      "type": "npm",
      "script": "verify",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "lint (luacheck)",
      "type": "shell",
      "command": "luacheck . --formatter plain --codes",
      "group": "build",
      "problemMatcher": {
        "owner": "luacheck",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+?):(\\d+):(\\d+): \\((W|E)(\\d+)\\) (.*)$",
          "file": 1, "line": 2, "column": 3, "severity": 4, "code": 5, "message": 6
        }
      }
    },
    {
      "label": "Lua coverage",
      "detail": "Line coverage of the addon Lua under the harness",
      "type": "npm",
      "script": "coverage",
      "problemMatcher": []
    },
    { "label": "package zip", "type": "npm", "script": "package", "problemMatcher": [] },
    { "label": "preview screenshots", "type": "npm", "script": "preview", "problemMatcher": [] },
    { "label": "link into WoW", "type": "npm", "script": "link:wow", "problemMatcher": [] },
    {
      "label": "link status",
      "type": "shell",
      "command": "npm run -s link:wow -- --status",
      "problemMatcher": []
    }
  ]
}
