# CurseForge (and Wago) packaging: what their packager puts in the Vanguard
# folder of the zip. It must hold exactly what scripts/package.mjs puts in the
# release zip (the TOC, every file it loads, Media/, the libraries' licenses
# and LICENSE); scripts/pkgmeta.test.mjs fails if the two ever differ.
# Vanguard.toc carries the CurseForge and Wago project IDs (## X-Curse-Project-ID,
# ## X-Wago-ID), which the packager reads (docs/DEVELOPMENT.md, Releases on CurseForge).

package-as: Vanguard

enable-nolib-creation: no

ignore:
  - .github
  - .claude
  - .githooks
  - .planning
  - .vscode
  - art
  - docs
  - scripts
  - tools
  - README.md
  - CLAUDE.md
  - package.json
  - package-lock.json
  - vitest.config.mjs
  - .editorconfig
  - .gitattributes
  - .gitignore
  - .markdownlint-cli2.jsonc
  - .luacheckrc
  - .nvmrc
  - .pkgmeta
  - _typos.toml
