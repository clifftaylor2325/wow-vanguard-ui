{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel 2>/dev/null || echo \"$CLAUDE_PROJECT_DIR\")/scripts/agent-check.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the edited file against the CLAUDE.md rules"
          }
        ]
      }
    ]
  }
}
